{
  "name": "kriterion-tooling",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "prepare": "husky",
    "lint": "npm --prefix code/frontend run lint",
    "lint:fix": "npm --prefix code/frontend run lint:fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "type-check": "npm --prefix code/frontend run type-check",
    "precommit": "lint-staged && npm run lint",
    "prepush": "npm run type-check"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.10"
  },
  "lint-staged": {
    "code/frontend/**/*.{ts,tsx,js,jsx}": [
      "npm --prefix code/frontend run lint:fix --"
    ],
    "**/*.{json,md,yml,yaml,css,scss,html,sql}": [
      "prettier --write",
      "prettier --check"
    ]
  }
}
